# Copy to .env. Credentials come from the standard AWS chain (env, profile, Lambda role).
APP_STAGE=dev
REGION_NAME=eu-central-1
DYNAMODB_TABLE=projecthub
# DYNAMODB_HOST=http://localhost:8000   # DynamoDB Local only
AWS_COGNITO_APP_CLIENT_ID=your_cognito_app_client_id
AWS_COGNITO_APP_CLIENT_SECRET=your_cognito_app_client_secret
AWS_COGNITO_USER_POOL_ID=your_cognito_user_pool_id
